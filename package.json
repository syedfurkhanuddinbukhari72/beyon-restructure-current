{
  "name": "beyon-admin-desktop",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.js",
  "homepage": "./",
  "scripts": {
    "dev": "npm run electron:dev",
    "cap:copy": "npx cap copy android",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "web:build": "cd beyon79 && npm run build",
    "preelectron:dev": "node scripts/ensure-dev-port.js",
    "electron:dev": "cross-env ELECTRON_DEV=true concurrently -k \"cd beyon79 && npm run dev\" \"wait-on http://localhost:3000/admin-unified && electron .\"",
    "electron:pack": "npm run web:build && electron .",
    "electron:build": "npm run web:build && electron-builder",
    "dist": "npm run web:build && electron-builder --publish=never"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@tanstack/react-query": "^5.90.20",
    "mongodb": "^6.0.0",
    "mongoose": "^8.0.0",
    "swr": "^2.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.2.2",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "electron": "32.3.3",
    "electron-builder": "^25.0.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.2.0",
    "jimp": "^1.6.0",
    "kill-port": "^2.0.1",
    "png-to-ico": "^3.0.1",
    "prettier": "^3.8.1",
    "sharp": "^0.34.4",
    "to-ico": "^1.1.5",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.beyon.admindesktop",
    "productName": "Beyon Admin",
    "copyright": "Copyright © 2025 Beyon",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/**/*.node"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "electron/assets"
    },
    "files": [
      "electron/**/*",
      "beyon79/out/**/*",
      "beyon79/public/**/*",
      "beyon79/package.json",
      "beyon79/next.config.js"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Beyon Admin",
      "deleteAppDataOnUninstall": true
    }
  }
}
